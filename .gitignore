# ---- Kết quả sinh ra khi chạy (tái tạo được bằng scripts/run_all.sh) ----
# Chi tiết từng lần chạy rất nhiều file (~15 MB cho ma trận 60 lần): không đưa vào git.
results/*_tasks.csv
results/*_util.csv
results/*_scale.csv
# Thư mục chạy thử tạm (results_test, results_tmp, ...).
results_*/
# Giữ results/summary.csv (nhỏ, là kết quả chính) và figures/ (bảng, biểu đồ cho báo cáo).
# Lưu ý: summary.csv được nối thêm vào cuối mỗi lần chạy; xóa trước khi chạy lại ma trận (xem CLAUDE.md).

